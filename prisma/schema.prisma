generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  mustChangePassword  Boolean              @default(false)
  failedLoginAttempts Int                  @default(0)
  lockedUntil         DateTime?
  roleId              String
  role                Role                 @relation(fields: [roleId], references: [id])
  employee            Employee?
  resetTokens         PasswordResetToken[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Role {
  id        String   @id @default(cuid())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expires   DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Department {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  employees   Employee[]
  createdAt   DateTime   @default(now())
}

model Position {
  id         String     @id @default(cuid())
  name       String     @unique
  salaryBase Int        @default(0)
  employees  Employee[]
  createdAt  DateTime   @default(now())
}

enum EmployeeStatus {
  ACTIVE
  PROBATION
  RESIGNED
  TERMINATED
}

enum PtkpStatus {
  TK0
  TK1
  TK2
  TK3
  K0
  K1
  K2
  K3
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  REMOTE
  FREELANCE
}

model Employee {
  id     String  @id @default(uuid())
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  name                String
  email               String         @unique
  nip                 String?        @unique
  joinDate            DateTime?      @default(now())
  status              EmployeeStatus @default(PROBATION)
  employmentType      EmploymentType @default(FULL_TIME)
  salaryBase          Int            @default(0)
  leaveQuota          Int            @default(12)
  ptkpStatus          PtkpStatus     @default(TK0)
  bpjsKesehatan       Boolean        @default(true)
  bpjsKetenagakerjaan Boolean        @default(true)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  positionId   String?
  position     Position?   @relation(fields: [positionId], references: [id])

  managerId    String?
  manager      Employee?  @relation("ManagerToSubordinate", fields: [managerId], references: [id])
  subordinates Employee[] @relation("ManagerToSubordinate")

  avatar         String?
  phone          String?
  address        String?
  gender         String?
  birthDate      DateTime?
  placeOfBirth   String?
  identityNumber String?
  bio            String?   @db.Text

  bankName       String?
  bankAccount    String?
  bankHolderName String?
  npwpNumber     String?

  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?

  education String?
  skills    String?

  isProfileComplete Boolean   @default(false)
  onboardedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances   Attendance[]
  salaries      Salary[]
  leaveRequests LeaveRequest[]

  managerApprovedLeaves LeaveRequest[] @relation("LeaveManagerApprover")
  hrApprovedLeaves      LeaveRequest[] @relation("LeaveHrApprover")
  rejectedLeaves        LeaveRequest[] @relation("LeaveRejector")

  attendanceCorrections AttendanceCorrection[] @relation("CorrectionRequester")
  reviewedCorrections   AttendanceCorrection[] @relation("CorrectionReviewer")
  payrollComponents     PayrollComponent[]
}

enum AttendanceStatus {
  PRESENT
  LATE
  EARLY_LEAVE
  ABSENT
  PERMISSION
  SICK
}

model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  date     DateTime  @db.Date
  checkIn  DateTime?
  checkOut DateTime?

  lateInMinutes Int     @default(0)
  workHours     Float   @default(0)
  isOvertime    Boolean @default(false)
  overtimeHours Float   @default(0)

  status   AttendanceStatus @default(PRESENT)
  location String?
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model AttendanceCorrection {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation("CorrectionRequester", fields: [employeeId], references: [id])

  date     DateTime  @db.Date
  checkIn  DateTime?
  checkOut DateTime?
  reason   String

  status          CorrectionStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      Employee?        @relation("CorrectionReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, date])
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())
}

enum LeaveType {
  ANNUAL
  SICK
  EMERGENCY
  UNPAID
}

enum LeaveStatus {
  PENDING
  MANAGER_APPROVED
  HR_APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  type      LeaveType @default(ANNUAL)
  startDate DateTime
  endDate   DateTime
  duration  Int
  reason    String

  status LeaveStatus @default(PENDING)

  managerApproverId String?
  managerApprover   Employee? @relation("LeaveManagerApprover", fields: [managerApproverId], references: [id])
  managerApprovedAt DateTime?

  hrApproverId String?
  hrApprover   Employee? @relation("LeaveHrApprover", fields: [hrApproverId], references: [id])
  hrApprovedAt DateTime?

  rejectedById    String?
  rejectedBy      Employee? @relation("LeaveRejector", fields: [rejectedById], references: [id])
  rejectedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Salary {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  periodMonth Int
  periodYear  Int

  basicSalary    Int
  allowances     Int @default(0)
  deductions     Int @default(0)
  overtimePay    Int @default(0)
  unpaidLeaveCut Int @default(0)

  bpjsKesEmployee Int @default(0)
  bpjsKesEmployer Int @default(0)
  jhtEmployee     Int @default(0)
  jhtEmployer     Int @default(0)
  jpEmployee      Int @default(0)
  jpEmployer      Int @default(0)
  jkkEmployer     Int @default(0)
  jkmEmployer     Int @default(0)

  ptkpStatus    PtkpStatus?
  taxableIncome Int         @default(0)
  pph21         Int         @default(0)
  pph21Method   String?
  components    Json?

  totalGross Int
  totalNet   Int

  isPaid Boolean   @default(false)
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, periodMonth, periodYear])
}

enum PayrollComponentType {
  ALLOWANCE
  DEDUCTION
}

model PayrollComponent {
  id         String               @id @default(cuid())
  employeeId String
  employee   Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name       String
  type       PayrollComponentType
  amount     Int
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
}

model CompanySetting {
  id                   String  @id @default("default")
  companyName          String  @default("Perusahaan Saya")
  companyCode          String?
  npwp                 String?
  phone                String?
  workStartTime        String  @default("08:00")
  workEndTime          String  @default("17:00")
  lateToleranceMinutes Int     @default(15)
  overtimeRatePerHour  Int     @default(50000)
  workingDaysPerMonth  Int     @default(22)
  annualLeaveQuota     Int     @default(12)
  bpjsKesehatanWageCap Int     @default(12000000)
  jpWageCap            Int     @default(11086300)
  jkkRateBps           Int     @default(24)
  bpjsMinimumWage      Int     @default(0)

  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorName   String
  action      String
  entity      String
  entityId    String?
  targetName  String?
  detail      String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}
